NODE_ENV=development
PORT=5000
# Comma-separated allowlist for browser origins (must match frontend URL exactly)
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/backend-practise

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset-secret-min-32-chars
JWT_RESET_EXPIRES_IN=10m
# cookie = httpOnly refresh cookie (SPAs); body = refresh token in JSON (mobile/API clients)
# Refresh/logout accept token from cookie OR body either way
AUTH_TOKEN_DELIVERY=cookie

# OTP
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# Email (optional in dev — OTP logs to console if SMTP not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Bootstrap admin (first user only, when DB is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=Super Admin

# AWS S3 (optional — leave blank to disable /api/upload)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
